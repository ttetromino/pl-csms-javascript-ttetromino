<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title><%= applicationName %></title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>
  <main class="container">
    <section class="card">
      <p class="label">
        Programming Languages Laboratory
      </p>

      <h1><%= applicationName %></h1>

      <p class="message">
        Starter application initialized successfully.
      </p>

      <dl class="details">
        <div>
          <dt>Current Sprint</dt>
          <dd><%= currentSprint %></dd>
        </div>

        <div>
          <dt>Technology</dt>
          <dd><%= technology %></dd>
        </div>

        <div>
          <dt>Version</dt>
          <dd><%= applicationVersion %></dd>
        </div>
      </dl>

      <p class="status">
        Environment status: Ready
      </p>

      <div class="footer-links" style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #e5e7eb;">
        <a href="/dashboard" style="display: inline-block; padding: 0.75rem 1.5rem; background: #3b82f6; color: white; text-decoration: none; border-radius: 0.5rem; margin-right: 1rem;">
          Dashboard
        </a>
        <a href="/residents" style="display: inline-block; padding: 0.75rem 1.5rem; background: #3b82f6; color: white; text-decoration: none; border-radius: 0.5rem; margin-right: 1rem;">
          Resident Management
        </a>
        <a href="/service-requests" style="display: inline-block; padding: 0.75rem 1.5rem; background: #3b82f6; color: white; text-decoration: none; border-radius: 0.5rem;">
          Service Request Management
        </a>
      </div>
    </section>
  </main>
</body>
</html>