<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Request Management - CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <section class="card">
      <nav class="module-nav">
        <a href="/residents">Residents</a>
        <a href="/service-requests" class="active">Service Requests</a>
      </nav>

      <h1>Service Request Management</h1>

      <% if (successMessage) { %>
        <div class="success-message"><%= successMessage %></div>
      <% } %>
      <% if (errorMessage) { %>
        <div class="error-message"><%= errorMessage %></div>
      <% } %>

      <div class="actions">
        <a href="/service-requests/new" class="button">Submit Service Request</a>
      </div>

      <form method="GET" action="/service-requests" class="search-form">
        <div class="search-row">
          <div class="form-group">
            <label for="search">Search:</label>
            <input
              type="text"
              id="search"
              name="search"
              value="<%= searchTerm %>"
              placeholder="Service type or description"
            >
          </div>
          <div class="form-group">
            <label for="status">Status:</label>
            <select id="status" name="status">
              <option value="" <%= statusFilter === "" ? "selected" : "" %>>All Statuses</option>
              <option value="Pending" <%= statusFilter === "Pending" ? "selected" : "" %>>Pending</option>
              <option value="In Progress" <%= statusFilter === "In Progress" ? "selected" : "" %>>In Progress</option>
              <option value="Completed" <%= statusFilter === "Completed" ? "selected" : "" %>>Completed</option>
              <option value="Cancelled" <%= statusFilter === "Cancelled" ? "selected" : "" %>>Cancelled</option>
            </select>
          </div>
          <div class="form-group form-group-action">
            <label>&nbsp;</label>
            <div>
              <button type="submit" class="button">Search</button>
              <% if (searchTerm || statusFilter) { %>
                <a href="/service-requests" class="button button-secondary">Clear</a>
              <% } %>
            </div>
          </div>
        </div>
      </form>

      <% if (serviceRequests.length === 0) { %>
        <p class="message">No Service Requests found.</p>
      <% } else { %>
        <table class="residents-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Resident ID</th>
              <th>Service Type</th>
              <th>Date Requested</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% serviceRequests.forEach(sr => { %>
              <tr>
                <td><%= sr.id %></td>
                <td><%= sr.residentId %></td>
                <td><%= sr.serviceType %></td>
                <td><%= sr.dateRequested %></td>
                <td>
                  <span class="status-badge status-<%= sr.status.toLowerCase().replace(' ', '-') %>">
                    <%= sr.status %>
                  </span>
                </td>
                <td>
                  <a href="/service-requests/<%= sr.id %>" class="button button-small">View</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <div class="footer-links">
        <a href="/">← Back to Home</a>
      </div>
    </section>
  </main>
</body>
</html>
